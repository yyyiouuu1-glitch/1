# ==========================================
# 壹品整装 · AI 协同工作台环境变量配置
# 使用方式：复制本文件为 .env.local 并填入真实密钥
# 提示：不填密钥也可直接本地启动，系统会自动进入「内置演示模式」
# ==========================================

# 1. 品牌基础信息
NEXT_PUBLIC_BRAND_NAME=壹品整装
NEXT_PUBLIC_BRAND_EN=YIPIN DECORATION
NEXT_PUBLIC_CITY=广佛

# 2. Supabase 数据库与对象存储（前往 https://supabase.com 免费创建项目）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 3. 文本大模型 API（兼容所有 OpenAI 格式：DeepSeek / 通义千问 / Gemini / OpenAI）
# 示例 - DeepSeek: https://api.deepseek.com/v1  模型: deepseek-chat
# 示例 - 通义千问: https://dashscope.aliyuncs.com/compatible-mode/v1  模型: qwen-plus
AI_TEXT_API_BASE=https://api.deepseek.com/v1
AI_TEXT_API_KEY=
AI_TEXT_MODEL=deepseek-chat

# 4. 空间变装生图 API（选填，不填则使用内置异步演示流）
# 可对接支持图生图/ControlNet 的云端接口（如硅基流动、Replicate、即梦或自建 ComfyUI 网关）
AI_IMAGE_API_BASE=
AI_IMAGE_API_KEY=
AI_IMAGE_MODEL=flux-dev-controlnet
